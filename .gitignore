__pycache__/
*.pyc
.env
.venv/
venv/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cursor/

# Shared OAuth client (tokens live under projects/*/credentials)
credentials/*
!credentials/.gitkeep

# Per-project secrets and runtime
projects/*/credentials/*
!projects/*/credentials/.gitkeep
projects/*/data/episodes/*/
!projects/*/data/episodes/.gitkeep
projects/*/data/state/*
!projects/*/data/state/.gitkeep
projects/*/data/scripts/queue/*
!projects/*/data/scripts/queue/.gitkeep
!projects/*/data/scripts/queue/*.json
projects/*/data/scripts/done/*
!projects/*/data/scripts/done/.gitkeep
projects/*/data/brand_refs/*
!projects/*/data/brand_refs/.gitkeep

*.pickle
token.json
client_secret*.json
*.mp4
*.wav
*.mp3
*.m4a
!projects/*/assets/music/.gitkeep

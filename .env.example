# Active project (CLI -p overrides).
PROJECT_ID=demo_facts

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional providers
ELEVENLABS_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
KLING_API_KEY=

# Scripts: leave empty to use projects/<id>/project.json
# SCRIPT_SOURCE=local
# SCRIPT_SOURCE=openai

# Providers: openai | fal | replicate | placeholder
IMAGE_PROVIDER=openai
# Brand sheets: auto | openai | fal | pollinations | local
BRAND_REF_PROVIDER=auto
# Override project.json image_use_refs if set
# IMAGE_USE_REFS=true
# openai | elevenlabs
TTS_PROVIDER=openai
# stub | runway | kling | fal
VIDEO_PROVIDER=stub

# Episode geometry
LANGUAGE=en
VIDEO_FORMAT=shorts
TARGET_DURATION_SEC=60
# MAX_AI_VIDEO_SHOTS=  # empty → project.json
AI_VIDEO_MAX_SEC=4

# YouTube (MADE_FOR_KIDS / category / privacy empty → project.json)
# MADE_FOR_KIDS=false
YOUTUBE_PRIVACY=
AUTO_PUBLISH=false
DRY_RUN=true
# PUBLISH_AT=2026-11-01T15:00:00Z

# Soft cost caps (USD)
DAILY_MAX_EPISODES=3
DAILY_MAX_COST_USD=15

# Optional: ffmpeg-full for libass karaoke captions
# brew install ffmpeg-full
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
